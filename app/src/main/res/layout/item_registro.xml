<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de cada linha da ListView (usado pelo RegistroAdapter) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ControleProducao.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Faixa colorida indicando a prioridade -->
        <View
            android:id="@+id/view_faixa_prioridade"
            android:layout_width="@dimen/largura_faixa_prioridade"
            android:layout_height="match_parent"
            tools:background="@color/prioridade_alta" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/espaco_medio">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_item_titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/texto_principal"
                    tools:text="Checklist de partida da linha 2" />

                <TextView
                    android:id="@+id/tv_item_prioridade"
                    style="@style/ControleProducao.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaco_pequeno"
                    tools:text="Alta"
                    tools:textColor="@color/prioridade_alta" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_item_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/azul_industrial"
                tools:text="Montagem • Checklist" />

            <TextView
                android:id="@+id/tv_item_descricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/texto_secundario"
                tools:text="Verificar EPIs, nível de óleo, sensores de segurança e botão de emergência." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_item_data"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/texto_secundario"
                    tools:text="20/11/2026 08:15" />

                <TextView
                    android:id="@+id/tv_item_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textStyle="bold"
                    tools:text="● Pendente"
                    tools:textColor="@color/status_pendente" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
