<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/editTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/campo_titulo"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/editSetor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/campo_setor"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/editDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:gravity="top"
            android:hint="@string/campo_descricao"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" />

        <CheckBox
            android:id="@+id/checkConcluido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/campo_concluido" />

        <Button
            android:id="@+id/buttonSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/acao_salvar" />

        <!-- Visível apenas ao editar um registro existente -->
        <Button
            android:id="@+id/buttonExcluir"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/acao_excluir"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
