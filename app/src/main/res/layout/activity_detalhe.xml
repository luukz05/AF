<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de detalhes (somente leitura) de um registro -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true"
    tools:context=".DetalheActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_tela">

        <com.google.android.material.card.MaterialCardView
            style="@style/ControleProducao.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margem_tela">

                <TextView
                    android:id="@+id/tv_detalhe_titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="@color/texto_principal"
                    android:textStyle="bold"
                    tools:text="Checklist de partida da linha 2" />

                <!-- Selos de prioridade e situação -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_pequeno"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_detalhe_prioridade"
                        style="@style/ControleProducao.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Prioridade Alta"
                        tools:textColor="@color/prioridade_alta" />

                    <TextView
                        android:id="@+id/tv_detalhe_status"
                        style="@style/ControleProducao.Badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaco_pequeno"
                        tools:text="● Pendente"
                        tools:textColor="@color/status_pendente" />
                </LinearLayout>

                <TextView
                    style="@style/ControleProducao.Rotulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rotulo_setor" />

                <TextView
                    android:id="@+id/tv_detalhe_setor"
                    style="@style/ControleProducao.Valor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Montagem" />

                <TextView
                    style="@style/ControleProducao.Rotulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rotulo_tipo" />

                <TextView
                    android:id="@+id/tv_detalhe_tipo"
                    style="@style/ControleProducao.Valor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Checklist" />

                <TextView
                    style="@style/ControleProducao.Rotulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rotulo_responsavel" />

                <TextView
                    android:id="@+id/tv_detalhe_responsavel"
                    style="@style/ControleProducao.Valor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Carlos Lima" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ControleProducao.Rotulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rotulo_criado_em" />

                        <TextView
                            android:id="@+id/tv_detalhe_criado_em"
                            style="@style/ControleProducao.Valor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="20/11/2026 08:15" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ControleProducao.Rotulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rotulo_atualizado_em" />

                        <TextView
                            android:id="@+id/tv_detalhe_atualizado_em"
                            style="@style/ControleProducao.Valor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="20/11/2026 09:40" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/ControleProducao.Rotulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rotulo_descricao" />

                <TextView
                    android:id="@+id/tv_detalhe_descricao"
                    style="@style/ControleProducao.Valor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textIsSelectable="true"
                    tools:text="Verificar EPIs, nível de óleo, sensores de segurança e botão de emergência antes de iniciar o turno." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/espaco_grande" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_alternar_status"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_botao"
            android:text="@string/acao_marcar_concluido"
            android:textSize="16sp"
            app:icon="@drawable/ic_check" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_editar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_botao"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:text="@string/acao_editar"
            android:textSize="16sp"
            app:icon="@drawable/ic_edit" />
    </LinearLayout>
</ScrollView>
