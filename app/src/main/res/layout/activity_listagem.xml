<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de listagem: busca + filtros + ListView + FAB para novo registro -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_listagem"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    tools:context=".ListagemActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Área de busca e filtros -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/superficie"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/margem_tela"
            android:paddingTop="@dimen/espaco_medio"
            android:paddingEnd="@dimen/margem_tela"
            android:paddingBottom="@dimen/espaco_pequeno">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/busca_dica"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_busca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_filtro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:checkedChip="@+id/chip_filtro_todos"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filtro_todos"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filtro_todos" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filtro_pendentes"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filtro_pendentes" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_filtro_concluidos"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filtro_concluidos" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_contador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/texto_secundario"
                tools:text="3 registros" />
        </LinearLayout>

        <!-- Lista + estado vazio -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/lv_registros"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="@dimen/espaco_pequeno"
                android:paddingStart="@dimen/margem_tela"
                android:paddingTop="@dimen/espaco_medio"
                android:paddingEnd="@dimen/margem_tela"
                android:paddingBottom="@dimen/espaco_fab"
                android:scrollbarStyle="outsideOverlay"
                tools:listitem="@layout/item_registro" />

            <LinearLayout
                android:id="@+id/layout_vazio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/espaco_grande"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_inbox"
                    app:tint="@color/borda" />

                <TextView
                    android:id="@+id/tv_vazio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaco_medio"
                    android:gravity="center"
                    android:text="@string/lista_vazia"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/texto_secundario" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Botão flutuante para novo registro -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_novo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/margem_tela"
        android:text="@string/acao_novo"
        app:icon="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
